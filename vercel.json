{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "web-dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/api/simulate",
      "destination": "/api/simulate.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
